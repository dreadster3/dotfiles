{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/heads/main/crates/nono-cli/data/nono-profile.schema.json",
  "extends": "nolabs-ai/pi",
  "meta": {
    "name": "pi"
  },
  "groups": {
    "include": ["go_runtime", "go_runtime_linux", "go_runtime_macos"]
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "set_vars": {
      "NODE_USE_ENV_PROXY": "1",
      "NODE_OPTIONS": "--disable-warning=ExperimentalWarning --disable-warning=Warning",
      "UV_TOOL_DIR": "/tmp/sandbox/.pi/uv/tools",
      "FASTMCP_HOME": "/tmp/sandbox/.pi/fastmcp",
      "KUBECONFIG": "$HOME/.kube/ai/debugger.yaml"
    }
  },
  "filesystem": {
    "allow": ["/tmp", "$HOME/.pi/agent/settings.json"],
    "read": [
      "$HOME/Documents/projects/github/pi-config/config",
      "$HOME/.hindsight",
      "$HOME/.plannotator",
      "$HOME/.kube/ai"
    ]
  },
  "credential_providers": {
    "litellm_oauth": {
      "type": "oauth_capture",
      "token_endpoints": [
        {
          "host": "https://litellm.<external-domain>",
          "path": "/token",
          "response_fields": [
            { "path": "access_token", "kind": "opaque" },
            { "path": "refresh_token", "kind": "opaque" }
          ],
          "request_body": "form",
          "request_nonce_fields": ["refresh_token"]
        }
      ],
      "api_hosts": ["https://litellm.<external-domain>"]
    }
  },
  "credential_routes": [
    { "name": "litellm_oauth_api", "provider": "litellm_oauth" }
  ],
  "credential_capture": {
    "github_cli": {
      "command": ["gh", "auth", "token"],
      "timeout_secs": 5,
      "cache_ttl_secs": 600,
      "output": "text"
    }
  },
  "linux": {
    "sandbox_policy": "external"
  },
  "network": {
    "allow_domain": [
      "pi.dev",
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "api.exa.ai",
      "mcp.exa.ai"
    ],
    "credentials": ["litellm", "hindsight", "litellm-gateway"],
    "open_port_range": [[8377, 8396]],
    "open_port": [19876],

    "custom_credentials": {
      "litellm": {
        "upstream": "https://litellm.<internal-domain>",
        "credential_key": "litellm",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "LITELLM_API_KEY"
      },
      "hindsight": {
        "upstream": "https://hindsight.<internal-domain>",
        "credential_key": "hindsight",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "env_var": "HINDSIGHT_API_TOKEN",
        "proxy": {
          "inject_mode": "header",
          "inject_header": "Authorization",
          "credential_format": "Bearer {}"
        }
      },
      "litellm-gateway": {
        "upstream": "https://litellm.<external-domain>",
        "credential_key": "litellm",
        "inject_header": "x-litellm-api-key",
        "credential_format": "Bearer {}",
        "env_var": "LITELLM_API_KEY",
        "proxy": {
          "inject_mode": "header",
          "inject_header": "x-litellm-api-key",
          "credential_format": "Bearer {}"
        }
      }
    }
  },
  "command_policies": {
    "credentials": {
      "ssh-agent": {
        "type": "local-socket",
        "path": "$SSH_AUTH_SOCK",
        "mode": "connect",
        "env_var": "SSH_AUTH_SOCK"
      },
      "docker": {
        "type": "local-socket",
        "path": "/run/docker.sock",
        "mode": "connect"
      },
      "github-cli": {
        "type": "proxy",
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github_cli",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    },
    "approval_backends": {
      "terminal": {
        "type": "terminal",
        "timeout_secs": 600
      }
    },
    "approval_defaults": {
      "backend": "terminal",
      "timeout_secs": 600
    },
    "commands": {
      "docker": {
        "from": {
          "session": {
            "sandbox": {
              "use_credentials": ["docker"],
              "network": { "allow_all": true },
              "fs_read": [
                ".",
                "$HOME/.docker",
                "/nix/store",
                "$XDG_STATE_HOME/nono"
              ],
              "fs_read_file": ["$HOME/.docker/config.json"],
              "fs_write": [".", "$HOME/.docker/buildx"],
              "exec_paths": ["/nix/store"]
            },
            "invocation_policy": {
              "default": "deny",
              "allow": [
                {
                  "argv": { "prefix": ["build"] },
                  "reason": "docker build is allowed for development"
                },
                {
                  "argv": { "prefix": ["container", "ls"] },
                  "reason": "docker container ls is allowed for development"
                },
                {
                  "argv": { "prefix": ["info"] },
                  "reason": "docker info is allowed"
                }
              ]
            }
          }
        }
      },
      "git": {
        "can_use": ["ssh"],
        "from": {
          "session": {
            "sandbox": {
              "use_credentials": ["ssh-agent"],
              "fs_read": ["."],
              "fs_read_file": [
                "$HOME/.config/git/config",
                "$HOME/.config/git/ignore",
                "$HOME/.config/git/attributes"
              ],
              "fs_write": [".", "$HOME/.pi/agent/worktrees"],
              "environment": {
                "allow_vars": [
                  "PATH",
                  "HOME",
                  "USER",
                  "LOGNAME",
                  "LANG",
                  "LC_*",
                  "SSH_AUTH_SOCK"
                ]
              }
            },
            "invocation_policy": {
              "default": "allow",
              "deny": [
                {
                  "argv": { "contains": ["--force"] },
                  "reason": "force actions are not allowed"
                },
                {
                  "argv": { "contains": ["-f"] },
                  "reason": "force actions are not allowed"
                }
              ]
            }
          },
          "gh": {
            "sandbox": {
              "fs_read": [".", "@git:common-dir"],
              "fs_read_file": ["@git:config-files"]
            }
          }
        }
      },
      "ssh": {
        "from": {
          "sandbox": "deny",
          "git": {
            "use_credentials": ["ssh-agent"],
            "fs_read_file": ["$HOME/.ssh/known_hosts", "$HOME/.ssh/config"],
            "fs_write_file": ["$HOME/.ssh/known_hosts"],
            "network": { "allow_all": true },
            "argv_prepend": ["-o", "ControlMaster=no", "-o", "ControlPath=none"]
          }
        }
      },
      "gh": {
        "can_use": ["git"],
        "from": {
          "session": {
            "sandbox": {
              "credentials": [
                {
                  "name": "github-cli",
                  "endpoint_policy": {
                    "default": "allow"
                  }
                }
              ],
              "fs_read": [".", "$HOME/.config/gh", "/nix/store"],
              "fs_read_file": [],
              "fs_write": ["$XDG_CACHE_HOME/gh"],
              "exec_paths": ["/nix/store"],
              "network": {
                "allow_domain": ["github.com", "api.github.com"]
              },
              "environment": {}
            },
            "invocation_policy": {
              "default": "allow",
              "deny": [
                {
                  "argv": {
                    "prefix": ["auth"]
                  },
                  "reason": "gh auth is not allowed for security reasons"
                },
                {
                  "argv": {
                    "prefix": ["ssh-key"]
                  },
                  "reason": "gh ssh-key is not allowed for security reasons"
                },
                {
                  "argv": {
                    "prefix": ["gpg-key"]
                  },
                  "reason": "gh gpg-key is not allowed for security reasons"
                },
                {
                  "argv": {
                    "prefix": ["extension"]
                  },
                  "reason": "gh extension is not allowed for security reasons"
                },
                {
                  "argv": {
                    "prefix": ["alias"]
                  },
                  "reason": "gh extension is not allowed for security reasons"
                },
                {
                  "argv": {
                    "contains": ["delete"]
                  },
                  "reason": "gh delete operations is not allowed for security reasons"
                }
              ]
            }
          }
        }
      }
    }
  }
}
